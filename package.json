{
  "name": "agent-native-images",
  "productName": "Agent Native Images",
  "version": "1.1.6",
  "description": "A fast image launcher for Agent Native",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node test/desktop.cjs",
    "package": "electron-packager . 'Agent Native Images' --platform=darwin --arch=arm64 --out=release --overwrite --app-bundle-id=inc.agentnative.images --icon=assets/icon.icns --asar.unpackDir=node_modules --ignore='^/(test|release|README.md)'",
    "test:batch": "node test/batch-desktop.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.2.0",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "sharp": "0.35.4"
  }
}
